<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CLINIQ – Test Catalogue</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --sidebar-bg: #4a6fa0; --sidebar-hover: #4a6fa0; --accent: #4a6fa0;--accent-dark: #4a6fa0;
    --bulk-green: #2ecc71; --btn-delete: #e74c3c; --white: #ffffff; --bg: #f0f4f8;
    --text-main: #1a2a3a; --text-muted: #6b7c93; --text-light: #a0aec0; --border: #dde3eb;
    --pill-hema: #6baed6; --pill-chem: #74c476; --pill-micro: #fd8d3c; --pill-endo: #c6a94a;
    --radius: 10px; --shadow: 0 2px 12px rgba(58,90,138,0.10);
  }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-main); display: flex; min-height: 100vh; }

  /* SIDEBAR */
  .sidebar { width: 210px; min-height: 100vh; background: var(--sidebar-bg); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; z-index: 100; }
  .sidebar-logo { display: flex; align-items: center; gap: 10px; padding: 18px 20px 16px; border-bottom: 1px solid rgba(255,255,255,0.15); }
  .sidebar-logo img { width: 36px; height: 36px; object-fit: contain; filter: brightness(0) invert(1); }
  .sidebar-logo span { font-size: 1.35rem; font-weight: 700; color: var(--white); letter-spacing: 1.5px; }
  .sidebar-user { display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-bottom: 1px solid rgba(255,255,255,0.10); }
  .user-avatar { width: 38px; height: 38px; background: rgba(255,255,255,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; color: var(--white); border: 1.5px solid rgba(255,255,255,0.35); flex-shrink: 0; }
  .user-info { display: flex; flex-direction: column; }
  .user-name { font-size: 0.82rem; font-weight: 600; color: var(--white); }
  .user-role { font-size: 0.68rem; color: rgba(255,255,255,0.65); }
  .sidebar-section { padding: 14px 14px 4px; font-size: 0.65rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.45); }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 20px; color: rgba(255,255,255,0.78); font-size: 0.87rem; font-weight: 500; cursor: pointer; border-radius: 6px; margin: 1px 8px; transition: background 0.15s, color 0.15s; text-decoration: none; }
  .nav-item:hover { background: var(--sidebar-hover); color: var(--white); }
  .nav-item.active { background: rgba(255,255,255,0.18); color: var(--white); font-weight: 600; }
  .nav-icon { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; opacity: 0.8; flex-shrink: 0; }
  .sidebar-footer { margin-top: auto; padding: 14px 8px; border-top: 1px solid rgba(255,255,255,0.12); }
  .signout-btn { display: flex; align-items: center; gap: 10px; padding: 9px 20px; color: rgba(255,255,255,0.75); font-size: 0.87rem; font-weight: 500; cursor: pointer; border-radius: 6px; transition: background 0.15s; }
  .signout-btn:hover { background: rgba(255,255,255,0.12); color: var(--white); }
  .sidebar-emblem { display: flex; justify-content: center; padding: 14px 0 18px; }
  .sidebar-emblem img { width: 54px; opacity: 0.3; filter: brightness(0) invert(1); }

  /* MAIN */
  .main { margin-left: 210px; flex: 1; display: flex; flex-direction: column; min-height: 100vh; }
  .topbar { background: #4a6fa0; height: 56px; display: flex; align-items: center; padding: 0 28px; border-bottom: 1px solid rgba(255,255,255,0.12); }
  .topbar-search { background: rgba(255,255,255,0.18); border: none; border-radius: 8px; padding: 7px 16px; color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 0.87rem; width: 300px; outline: none; transition: background 0.15s; }
  .topbar-search::placeholder { color: rgba(255,255,255,0.55); }
  .topbar-search:focus { background: rgba(255,255,255,0.28); }
  .content { padding: 32px 36px; flex: 1; }
  .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; }
  .page-title h1 { font-size: 1.65rem; font-weight: 700; color: var(--text-main); letter-spacing: -0.3px; }
  .page-title p { font-size: 0.85rem; color: var(--text-muted); margin-top: 3px; }
  .header-actions { display: flex; gap: 10px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s; }
  .btn-outline { background: var(--white); border: 1.5px solid var(--border); color: var(--text-main); }
  .btn-outline:hover { border-color: var(--accent); color: var(--accent); }
  .btn-primary { background: var(--accent); color: var(--white); }
  .btn-primary:hover { background: var(--accent-dark); }

  /* FILTER BAR */
  .filter-bar { display: flex; gap: 10px; margin-bottom: 18px; }
  .search-wrap { flex: 1; position: relative; }
  .search-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-light); pointer-events: none; }
  .search-input { width: 100%; padding: 10px 14px 10px 40px; border: 1.5px solid var(--border); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 0.87rem; color: var(--text-main); background: var(--white); outline: none; transition: border-color 0.15s; }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--text-light); }
  .cat-select { padding: 10px 14px; border: 1.5px solid var(--border); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: var(--text-main); background: var(--white); outline: none; cursor: pointer; }

  /* TABLE */
  .table-card { background: var(--white); border-radius: var(--radius); border: 1.5px solid var(--border); box-shadow: var(--shadow); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; }
  thead tr { background: #f8fafc; border-bottom: 1.5px solid var(--border); }
  th { padding: 13px 20px; text-align: left; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); }
  tbody tr { border-bottom: 1px solid var(--border); transition: background 0.1s; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: #f7f9fc; }
  td { padding: 15px 20px; font-size: 0.875rem; vertical-align: middle; }
  .test-code { font-family: 'DM Mono', monospace; font-size: 0.82rem; font-weight: 500; color: var(--accent); }
  .test-name { font-weight: 600; color: var(--text-main); }
  .test-cat-sub { font-size: 0.75rem; color: var(--text-muted); margin-top: 1px; }
  .pill { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; color: var(--white); white-space: nowrap; }
  .pill-hema { background: var(--pill-hema); } .pill-chem { background: var(--pill-chem); }
  .pill-micro { background: var(--pill-micro); } .pill-endo { background: var(--pill-endo); }
  .price-unit { color: var(--text-main); font-weight: 500; }
  .price-bulk { color: var(--bulk-green); font-weight: 700; }
  .action-btns { display: flex; gap: 6px; }
  .btn-edit { padding: 5px 13px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; background: var(--white); border: 1.5px solid var(--accent); color: var(--accent); cursor: pointer; transition: all 0.15s; }
  .btn-edit:hover { background: var(--accent); color: var(--white); }
  .btn-delete { padding: 5px 13px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; background: var(--btn-delete); border: none; color: var(--white); cursor: pointer; transition: opacity 0.15s; }
  .btn-delete:hover { opacity: 0.85; }
  .table-footer { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-top: 1.5px solid var(--border); background: #fafbfc; }
  .showing-text { font-size: 0.82rem; color: var(--text-muted); }
  .pagination { display: flex; gap: 5px; align-items: center; }
  .page-btn { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 7px; font-size: 0.82rem; font-weight: 600; border: 1.5px solid var(--border); background: var(--white); color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
  .page-btn:hover { border-color: var(--accent); color: var(--accent); }
  .page-btn.active { background: var(--accent); border-color: var(--accent); color: var(--white); }

  /* MODAL */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(20,35,55,0.45); backdrop-filter: blur(3px); z-index: 200; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--white); border-radius: 14px; padding: 30px; width: 460px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); animation: modalIn 0.2s ease; }
  @keyframes modalIn { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .modal-title { font-size: 1.1rem; font-weight: 700; color: var(--text-main); }
  .modal-close { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 7px; border: 1.5px solid var(--border); background: none; cursor: pointer; font-size: 1.1rem; color: var(--text-muted); transition: all 0.15s; }
  .modal-close:hover { background: #f0f4f8; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-group.full { grid-column: 1/-1; }
  .form-label { font-size: 0.78rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .form-input, .form-select { padding: 9px 12px; border: 1.5px solid var(--border); border-radius: 7px; font-family: 'DM Sans', sans-serif; font-size: 0.87rem; color: var(--text-main); outline: none; transition: border-color 0.15s; }
  .form-input:focus, .form-select:focus { border-color: var(--accent); }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 22px; }
  .delete-body { text-align: center; padding: 8px 0 4px; }
  .delete-icon { width: 54px; height: 54px; background: #fef2f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 1.6rem; }
  .btn-danger { background: var(--btn-delete); color: var(--white); }
  .btn-danger:hover { opacity: 0.88; }
</style>
</head>
<body>

<aside class="sidebar">
  <div class="sidebar-logo">
    <img src="Cliniq Logo.png" alt="CLINIQ Logo">
    <span>CLINIQ</span>
  </div>
  <div class="sidebar-user">
    <div class="user-avatar">MC</div>
    <div class="user-info">
      <span class="user-name">Curitana, MC</span>
      <span class="user-role">Lab Administrator</span>
    </div>
  </div>
  <nav style="padding:10px 0;flex:1;">
    <div class="sidebar-section">Overview</div>
    <a class="nav-item" href="#">
      <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
      Dashboard
    </a>
    <div class="sidebar-section" style="margin-top:6px;">Management</div>
    <a class="nav-item active" href="#">
      <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></span>
      Test Catalog
    </a>
    <a class="nav-item" href="#">
      <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg></span>
      Lab Requests
    </a>
    <a class="nav-item" href="#">
      <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
      Billing
    </a>
    <div class="sidebar-section" style="margin-top:6px;">Reports</div>
    <a class="nav-item" href="#">
      <span class="nav-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg></span>
      Analytics
    </a>
  </nav>
  <div class="sidebar-footer">
    <div class="signout-btn">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Sign Out
    </div>
    <div class="sidebar-emblem">
      <img src="Cliniq Logo.png" alt="">
    </div>
  </div>
</aside>

<div class="main">
  <div class="topbar">
    <input class="topbar-search" type="text" placeholder="Search...">
  </div>
  <div class="content">
    <div class="page-header">
      <div class="page-title">
        <h1>Test Catalogue</h1>
        <p>Manage diagnostic tests, pricing, and turnaround times</p>
      </div>
      <div class="header-actions">
        <button class="btn btn-outline">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Bulk Import
        </button>
        <button class="btn btn-primary" onclick="openAddModal()">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          Add Test
        </button>
      </div>
    </div>
    <div class="filter-bar">
      <div class="search-wrap">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input class="search-input" type="text" placeholder="Search test by name or code...." id="searchInput" oninput="filterTable()">
      </div>
      <select class="cat-select" id="catFilter" onchange="filterTable()">
        <option value="">All categories</option>
        <option value="Hematology">Hematology</option>
        <option value="Chemistry">Chemistry</option>
        <option value="Microbiology">Microbiology</option>
        <option value="Endocrinology">Endocrinology</option>
      </select>
    </div>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>Code</th><th>Test Name</th><th>Category</th><th>TAT</th><th>Unit Price</th><th>Bulk</th><th>Actions</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
      <div class="table-footer">
        <span class="showing-text" id="showingText"></span>
        <div class="pagination" id="pagination"></div>
      </div>
    </div>
  </div>
</div>

<!-- ADD/EDIT MODAL -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Add New Test</span>
      <button class="modal-close" onclick="closeModal('editModal')">✕</button>
    </div>
    <div class="form-grid">
      <div class="form-group"><label class="form-label">Test Code</label><input class="form-input" id="fCode" placeholder="e.g. CBC-001"></div>
      <div class="form-group"><label class="form-label">TAT</label><input class="form-input" id="fTat" placeholder="e.g. 4 hrs"></div>
      <div class="form-group full"><label class="form-label">Test Name</label><input class="form-input" id="fName" placeholder="Full test name"></div>
      <div class="form-group"><label class="form-label">Category</label>
        <select class="form-select" id="fCat">
          <option value="Hematology">Hematology</option><option value="Chemistry">Chemistry</option>
          <option value="Microbiology">Microbiology</option><option value="Endocrinology">Endocrinology</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Unit Price (₱)</label><input class="form-input" id="fUnit" placeholder="e.g. 350"></div>
      <div class="form-group"><label class="form-label">Bulk Price (₱)</label><input class="form-input" id="fBulk" placeholder="e.g. 290"></div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeModal('editModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveTest()">Save Test</button>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal" style="width:380px;">
    <div class="delete-body">
      <div class="delete-icon">🗑️</div>
      <h3 style="font-size:1.05rem;font-weight:700;margin-bottom:7px;">Delete Test?</h3>
      <p style="font-size:0.85rem;color:var(--text-muted);">This will permanently remove <strong id="deleteTestName"></strong>.</p>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeModal('deleteModal')">Cancel</button>
      <button class="btn btn-danger" onclick="confirmDelete()">Delete</button>
    </div>
  </div>
</div>

<script>
let tests = [
  { code:'CBC-001', name:'Complete Blood Count', cat:'Hematology',    tat:'4 hrs',  unit:350,  bulk:290  },
  { code:'LIP-001', name:'Lipid Panel',           cat:'Chemistry',     tat:'6 hrs',  unit:680,  bulk:580  },
  { code:'UA-001',  name:'Urinalysis',             cat:'Microbiology',  tat:'2 hrs',  unit:220,  bulk:180  },
  { code:'HBA-001', name:'HbA1c',                  cat:'Chemistry',     tat:'5 hrs',  unit:550,  bulk:460  },
  { code:'TSH-001', name:'Thyroid Panel',           cat:'Endocrinology', tat:'8 hrs',  unit:1200, bulk:1050 },
  { code:'CBC-002', name:'Differential Count',     cat:'Hematology',    tat:'3 hrs',  unit:280,  bulk:230  },
  { code:'CRP-001', name:'C-Reactive Protein',     cat:'Chemistry',     tat:'4 hrs',  unit:480,  bulk:400  },
  { code:'BLD-001', name:'Blood Culture',          cat:'Microbiology',  tat:'48 hrs', unit:950,  bulk:820  },
  { code:'INS-001', name:'Insulin Level',          cat:'Endocrinology', tat:'6 hrs',  unit:750,  bulk:640  },
  { code:'FER-001', name:'Ferritin',               cat:'Hematology',    tat:'5 hrs',  unit:620,  bulk:530  },
  { code:'LFT-001', name:'Liver Function Test',    cat:'Chemistry',     tat:'6 hrs',  unit:890,  bulk:760  },
  { code:'KFT-001', name:'Kidney Function Test',   cat:'Chemistry',     tat:'5 hrs',  unit:820,  bulk:700  },
];

const catColors = { Hematology:'pill-hema', Chemistry:'pill-chem', Microbiology:'pill-micro', Endocrinology:'pill-endo' };
const ROWS = 5;
let page = 1, filtered = [...tests], editIdx = -1, delIdx = -1;

function filterTable() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const cat = document.getElementById('catFilter').value;
  filtered = tests.filter(t => (t.name.toLowerCase().includes(q) || t.code.toLowerCase().includes(q)) && (!cat || t.cat === cat));
  page = 1; renderTable();
}

function renderTable() {
  const slice = filtered.slice((page-1)*ROWS, page*ROWS);
  document.getElementById('tableBody').innerHTML = slice.map(t => {
    const i = tests.indexOf(t);
    return `<tr>
      <td><span class="test-code">${t.code}</span></td>
      <td><div class="test-name">${t.name}</div><div class="test-cat-sub">${t.cat}</div></td>
      <td><span class="pill ${catColors[t.cat]}">${t.cat}</span></td>
      <td>${t.tat}</td>
      <td class="price-unit">₱${t.unit.toLocaleString()}</td>
      <td class="price-bulk">₱${t.bulk.toLocaleString()}</td>
      <td><div class="action-btns">
        <button class="btn-edit" onclick="openEditModal(${i})">Edit</button>
        <button class="btn-delete" onclick="openDeleteModal(${i})">Delete</button>
      </div></td>
    </tr>`;
  }).join('');
  const total = Math.ceil(filtered.length / ROWS);
  document.getElementById('showingText').textContent = `Showing page ${page} of ${total} (${filtered.length} tests)`;
  let pg = `<button class="page-btn" onclick="goPage(${page-1})">‹</button>`;
  for (let i=1;i<=total;i++) pg += `<button class="page-btn${i===page?' active':''}" onclick="goPage(${i})">${i}</button>`;
  pg += `<button class="page-btn" onclick="goPage(${page+1})">›</button>`;
  document.getElementById('pagination').innerHTML = pg;
}

function goPage(n) { const max=Math.ceil(filtered.length/ROWS); if(n<1||n>max)return; page=n; renderTable(); }

function openAddModal() {
  editIdx=-1; document.getElementById('modalTitle').textContent='Add New Test';
  ['fCode','fName','fTat','fUnit','fBulk'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('fCat').value='Hematology';
  document.getElementById('editModal').classList.add('open');
}
function openEditModal(i) {
  editIdx=i; const t=tests[i];
  document.getElementById('modalTitle').textContent='Edit Test';
  document.getElementById('fCode').value=t.code; document.getElementById('fName').value=t.name;
  document.getElementById('fCat').value=t.cat;   document.getElementById('fTat').value=t.tat;
  document.getElementById('fUnit').value=t.unit; document.getElementById('fBulk').value=t.bulk;
  document.getElementById('editModal').classList.add('open');
}
function saveTest() {
  const t={code:document.getElementById('fCode').value.trim(),name:document.getElementById('fName').value.trim(),
    cat:document.getElementById('fCat').value,tat:document.getElementById('fTat').value.trim(),
    unit:parseInt(document.getElementById('fUnit').value)||0,bulk:parseInt(document.getElementById('fBulk').value)||0};
  if(!t.code||!t.name){alert('Code and name are required.');return;}
  if(editIdx>=0)tests[editIdx]=t; else tests.push(t);
  closeModal('editModal'); filterTable();
}
function openDeleteModal(i) { delIdx=i; document.getElementById('deleteTestName').textContent=tests[i].name; document.getElementById('deleteModal').classList.add('open'); }
function confirmDelete() { if(delIdx>=0){tests.splice(delIdx,1);delIdx=-1;} closeModal('deleteModal'); filterTable(); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

renderTable();
</script>
</body>
</html>
