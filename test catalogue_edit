<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>CLINIQ – Test Catalogue</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
  body { background: #eef0f7; min-height: 100vh; display: flex; }

  .sidebar {
    width: 200px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    flex-shrink: 0;
    border-right: 1px solid #dde2f0;
  }
  /* top logo bar */
  .sidebar-logo {
    padding: 13px 12px 11px;
    display: flex;
    align-items: center;
    gap: 9px;
    background: #4a5ba0;
    border-bottom: 1px solid rgba(255,255,255,0.15);
  }
  .sidebar-logo img { width: 26px; height: 26px; object-fit: contain; filter: brightness(1.4); }
  .sidebar-logo span { color: #fff; font-size: 16px; font-weight: 700; letter-spacing: 1px; }

  .user-card {
    margin: 10px 10px 6px;
    background: #4a5ba0;
    border-radius: 9px;
    padding: 9px 11px;
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .avatar {
    width: 34px; height: 34px; border-radius: 7px;
    background: rgba(255,255,255,0.22);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
    border: 1.5px solid rgba(255,255,255,0.45);
  }
  .user-info p  { font-size: 12px; font-weight: 700; color: #fff; }
  .user-info span { font-size: 10px; color: rgba(255,255,255,0.7); }

  .nav-label {
    margin: 8px 10px 2px;
    padding: 4px 10px;
    font-size: 11px;
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.4px;
    background: #4a5ba0;
    border-radius: 5px;
    display: inline-block;
  }

  .nav-item {
    display: flex; align-items: center; gap: 9px;
    padding: 9px 14px;
    cursor: pointer;
    color: #3d4d8a;
    font-size: 13px; font-weight: 500;
    transition: background 0.15s;
    text-decoration: none;
  }
  .nav-item:hover  { background: #eef0f7; }
  .nav-item.active { background: #e4e8f5; font-weight: 600; color: #2e3a6e; }
  .nav-item svg    { width: 18px; height: 18px; flex-shrink: 0; color: #4a5ba0; }

  .sign-out-btn {
    margin: 6px 10px 0;
    padding: 8px 12px;
    display: flex; align-items: center; gap: 9px;
    color: #fff; font-size: 13px; font-weight: 600;
    background: #4a5ba0;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .sign-out-btn:hover { background: #3d4d8a; }
  .sign-out-btn svg { width: 16px; height: 16px; flex-shrink: 0; }

  .sidebar-bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 10px;
  }
  .sidebar-bottom img {
    width: 80px; height: 80px;
    object-fit: contain;
    opacity: 0.75;
  }

  .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
  .topbar {
    background: #4a5ba0; height: 50px;
    display: flex; align-items: center; padding: 0 20px;
  }
  .topbar input {
    background: rgba(255,255,255,0.18); border: none; border-radius: 8px;
    padding: 7px 14px; color: #fff; font-size: 13px; width: 240px; outline: none;
  }
  .topbar input::placeholder { color: rgba(255,255,255,0.55); }
  .content { flex: 1; overflow-y: auto; padding: 26px; }

  .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; }
  .page-title h2 { font-size: 22px; font-weight: 700; color: #1a1a2e; }
  .page-title p  { font-size: 12px; color: #888; margin-top: 3px; }
  .header-actions { display: flex; gap: 8px; }
  .btn-outline {
    padding: 8px 16px; border: 1.5px solid #3d4d8a; border-radius: 8px;
    background: #fff; color: #3d4d8a; font-size: 12px; font-weight: 600; cursor: pointer;
  }
  .btn-outline:hover { background: #eef0f7; }
  .btn-primary {
    padding: 8px 16px; border: none; border-radius: 8px;
    background: #3d4d8a; color: #fff; font-size: 12px; font-weight: 600; cursor: pointer;
  }
  .btn-primary:hover { background: #2e3a6e; }

  .search-bar {
    display: flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid #c9c9c6;
    border-radius: 10px; padding: 8px 14px; margin-bottom: 14px;
  }
  .search-bar input { border: none; outline: none; font-size: 13px; color: #333; flex: 1; background: transparent; }
  .search-bar input::placeholder { color: #aaa; }
  .cat-select {
    border: 1px solid #c9c9c6; border-radius: 6px; padding: 5px 8px;
    font-size: 12px; color: #555; background: #f9f9f9; cursor: pointer; outline: none;
  }

  .table-card { background: #fff; border-radius: 12px; border: 1px solid #c9c9c6; overflow: hidden; }
  .table-card table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .table-card thead th {
    color: #000; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.4px;
    padding: 14px 16px; border-bottom: 1.5px solid #c9c9c6;
    background: #fff; text-align: center;
  }
  .table-card tbody td {
    padding: 13px 16px; font-size: 0.78rem; color: #5d77a6;
    border-bottom: 1px solid #f5f5f5; vertical-align: middle; text-align: center;
  }
  .table-card tbody tr:last-child td { border-bottom: none; }
  .table-card tbody tr:hover { background: #f8f9fd; }

  .code-link { color: #3d4d8a; font-weight: 600; text-decoration: none; font-size: 12px; }
  .test-name-cell { text-align: left !important; }
  .test-name { font-weight: 600; color: #1a1a2e; font-size: 13px; }
  .test-sub  { color: #aaa; font-size: 11px; }

  .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
  .badge-Hematology   { background: #d4e8fb; color: #1a5fa8; }
  .badge-Chemistry    { background: #d4f5e1; color: #1a7a42; }
  .badge-Microbiology { background: #fdd4d4; color: #a81a1a; }
  .badge-Endocrinology{ background: #fdf5d4; color: #7a6a1a; }
  .badge-Immunology   { background: #e8d4fb; color: #5a1a9a; }

  .bulk-price { color: #27a75a; font-weight: 600; }
  .btn-edit {
    padding: 5px 12px; border: 1px solid #c9c9c6; border-radius: 6px;
    background: #fff; color: #444; font-size: 11px; cursor: pointer;
  }
  .btn-edit:hover { background: #f0f0f0; }
  .btn-delete {
    padding: 5px 12px; border: none; border-radius: 6px;
    background: #e24b4a; color: #fff; font-size: 11px; cursor: pointer; margin-left: 4px;
  }
  .btn-delete:hover { background: #c43232; }

  .table-footer {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; background: #fff; border-top: 1px solid #eee;
  }
  .showing { font-size: 12px; color: #888; }
  .pagination { display: flex; gap: 4px; }
  .pg-btn {
    width: 28px; height: 28px; border: 1px solid #c9c9c6; border-radius: 6px;
    background: #fff; font-size: 12px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; color: #555;
  }
  .pg-btn.active { background: #3d4d8a; color: #fff; border-color: #3d4d8a; }
  .pg-btn:hover:not(.active) { background: #f0f0f0; }

  .modal-overlay {
    position: fixed; inset: 0; background: rgba(30,30,60,0.45);
    display: flex; align-items: center; justify-content: center; z-index: 100;
  }
  .modal {
    background: #fff; border-radius: 14px; padding: 24px; width: 400px; border: 1px solid #c9c9c6;
  }
  .modal h3 { font-size: 16px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; }
  .form-group { margin-bottom: 12px; }
  .form-group label { display: block; font-size: 12px; color: #666; margin-bottom: 4px; font-weight: 500; }
  .form-group input, .form-group select {
    width: 100%; padding: 8px 10px; border: 1px solid #c9c9c6;
    border-radius: 8px; font-size: 13px; color: #333; outline: none;
  }
  .form-group input:focus, .form-group select:focus { border-color: #3d4d8a; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
  .no-results { text-align: center; padding: 30px; color: #aaa; font-size: 13px; }
  .drop-zone {
    border: 2px dashed #c9c9c6; border-radius: 10px; padding: 30px;
    text-align: center; color: #aaa; font-size: 13px;
  }
  .toast {
    position: fixed; bottom: 24px; right: 24px; background: #3d4d8a; color: #fff;
    padding: 10px 20px; border-radius: 10px; font-size: 13px; z-index: 200;
    opacity: 0; transition: opacity 0.3s; pointer-events: none;
  }
  .toast.show { opacity: 1; }
</style>
</head>
<body>

<div class="sidebar">
  <!-- top logo -->
  <div class="sidebar-logo">
    <img src="data:image/png;base64," alt="logo"/>
    <span>CLINIQ</span>
  </div>

  <div class="user-card">
    <div class="avatar">MC</div>
    <div class="user-info"><p>Curitana, MC</p><span>Lab Administrator</span></div>
  </div>

  <span class="nav-label">Overview</span>
  <a class="nav-item" href="#" onclick="setNav(event,this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </a>

  <span class="nav-label">Management</span>
  <a class="nav-item active" href="#" onclick="setNav(event,this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="14" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
    Test Catalog
  </a>
  <a class="nav-item" href="#" onclick="setNav(event,this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V9l-6-6z"/><polyline points="9 3 9 9 15 9"/></svg>
    Lab Requests
  </a>
  <a class="nav-item" href="#" onclick="setNav(event,this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="7" y1="15" x2="10" y2="15"/></svg>
    Billing
  </a>

  <span class="nav-label">Reports</span>
  <a class="nav-item" href="#" onclick="setNav(event,this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    Analytics
  </a>

  <div class="sidebar-bottom">
    <div class="sign-out-btn" onclick="">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign Out
    </div>
    <img src="data:image/png;base64," alt="CLINIQ logo" style="margin-top:10px; width:80px; height:80px; object-fit:contain;"/>
  </div>
</div>

<div class="main">
  <div class="topbar">
    <input placeholder="Search..." />
  </div>
  <div class="content">
    <div class="page-header">
      <div class="page-title">
        <h2>Test Catalogue</h2>
        <p>Manage diagnostic tests, pricing, and turnaround times</p>
      </div>
      <div class="header-actions">
        <button class="btn-outline" onclick="openBulkImport()">Bulk import</button>
        <button class="btn-primary" onclick="openAddModal()">+ Add test</button>
      </div>
    </div>
    <div class="search-bar">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="#aaa">
        <path d="M11.742 10.344a6.5 6.5 0 10-1.397 1.398l3.85 3.85a1 1 0 001.415-1.414l-3.868-3.834zm-5.242 1.156a5 5 0 110-10 5 5 0 010 10z"/>
      </svg>
      <input id="searchInput" placeholder="Search test by name or code...." oninput="currentPage=1;renderTable()" />
      <select class="cat-select" id="catFilter" onchange="currentPage=1;renderTable()">
        <option value="">All categories</option>
        <option>Hematology</option><option>Chemistry</option>
        <option>Microbiology</option><option>Endocrinology</option><option>Immunology</option>
      </select>
    </div>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th style="width:90px">Code</th>
            <th style="width:180px;text-align:left">Test Name</th>
            <th style="width:130px">Category</th>
            <th style="width:80px">TAT</th>
            <th style="width:100px">Unit Price</th>
            <th style="width:90px">Bulk</th>
            <th style="width:120px">Actions</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
      <div id="noResults" class="no-results" style="display:none">No tests found.</div>
      <div class="table-footer">
        <span class="showing" id="showingLabel"></span>
        <div class="pagination" id="pagination"></div>
      </div>
    </div>
  </div>
</div>

<div id="modalContainer"></div>
<div id="toast" class="toast"></div>

<script>
  const TESTS = [
    { id:1,  code:'CBC-001', name:'Complete Blood Count',  sub:'Hematology',    category:'Hematology',    tat:'4 hrs',  price:350,  bulk:290  },
    { id:2,  code:'LIP-001', name:'Lipid Panel',           sub:'Chemistry',     category:'Chemistry',     tat:'6 hrs',  price:680,  bulk:580  },
    { id:3,  code:'UA-001',  name:'Urinalysis',            sub:'Microbiology',  category:'Microbiology',  tat:'2 hrs',  price:220,  bulk:180  },
    { id:4,  code:'HBA-001', name:'HbA1c',                 sub:'Chemistry',     category:'Chemistry',     tat:'5 hrs',  price:550,  bulk:460  },
    { id:5,  code:'TSH-001', name:'Thyroid Panel',         sub:'Endocrinology', category:'Endocrinology', tat:'8 hrs',  price:1200, bulk:1050 },
    { id:6,  code:'ALB-001', name:'Albumin',               sub:'Chemistry',     category:'Chemistry',     tat:'3 hrs',  price:310,  bulk:260  },
    { id:7,  code:'CRP-001', name:'C-Reactive Protein',    sub:'Immunology',    category:'Immunology',    tat:'4 hrs',  price:490,  bulk:400  },
    { id:8,  code:'BMP-001', name:'Basic Metabolic Panel', sub:'Chemistry',     category:'Chemistry',     tat:'5 hrs',  price:780,  bulk:650  },
    { id:9,  code:'PT-001',  name:'Prothrombin Time',      sub:'Hematology',    category:'Hematology',    tat:'3 hrs',  price:420,  bulk:350  },
    { id:10, code:'GLU-001', name:'Blood Glucose',         sub:'Chemistry',     category:'Chemistry',     tat:'2 hrs',  price:180,  bulk:140  },
    { id:11, code:'CULT-001',name:'Urine Culture',         sub:'Microbiology',  category:'Microbiology',  tat:'48 hrs', price:650,  bulk:520  },
    { id:12, code:'ESR-001', name:'Erythrocyte Sed Rate',  sub:'Hematology',    category:'Hematology',    tat:'2 hrs',  price:280,  bulk:220  },
  ];

  let tests = [...TESTS];
  let currentPage = 1;
  const perPage = 5;

  function filtered() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    const cat = document.getElementById('catFilter').value;
    return tests.filter(t =>
      (!q || t.name.toLowerCase().includes(q) || t.code.toLowerCase().includes(q)) &&
      (!cat || t.category === cat)
    );
  }

  function renderTable() {
    const data = filtered();
    const total = data.length;
    const pages = Math.max(1, Math.ceil(total / perPage));
    if (currentPage > pages) currentPage = pages;
    const slice = data.slice((currentPage-1)*perPage, currentPage*perPage);
    const tbody = document.getElementById('tableBody');
    const noR = document.getElementById('noResults');
    if (slice.length === 0) { tbody.innerHTML=''; noR.style.display=''; }
    else {
      noR.style.display='none';
      tbody.innerHTML = slice.map(t => `
        <tr>
          <td><a class="code-link" href="#">${t.code}</a></td>
          <td class="test-name-cell"><div class="test-name">${t.name}</div><div class="test-sub">${t.sub}</div></td>
          <td><span class="badge badge-${t.category}">${t.category}</span></td>
          <td>${t.tat}</td>
          <td>&#8369;${t.price.toLocaleString()}</td>
          <td class="bulk-price">&#8369;${t.bulk.toLocaleString()}</td>
          <td>
            <button class="btn-edit" onclick="openEditModal(${t.id})">Edit</button>
            <button class="btn-delete" onclick="deleteTest(${t.id})">Delete</button>
          </td>
        </tr>`).join('');
    }
    document.getElementById('showingLabel').textContent =
      `Showing page ${currentPage} of ${pages} (${total} test${total!==1?'s':''})`;
    renderPagination(pages);
  }

  function renderPagination(pages) {
    const pg = document.getElementById('pagination');
    let html = `<button class="pg-btn" onclick="goPage(${currentPage-1})">&#8249;</button>`;
    for (let i=1;i<=pages;i++)
      html += `<button class="pg-btn${i===currentPage?' active':''}" onclick="goPage(${i})">${i}</button>`;
    html += `<button class="pg-btn" onclick="goPage(${currentPage+1})">&#8250;</button>`;
    pg.innerHTML = html;
  }

  function goPage(p) {
    const pages = Math.max(1, Math.ceil(filtered().length/perPage));
    currentPage = Math.max(1, Math.min(p, pages));
    renderTable();
  }

  function setNav(e, el) {
    e.preventDefault();
    document.querySelectorAll('.nav-item').forEach(x => x.classList.remove('active'));
    el.classList.add('active');
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2200);
  }

  function deleteTest(id) {
    if (!confirm('Delete this test?')) return;
    tests = tests.filter(t => t.id !== id);
    renderTable(); showToast('Test deleted.');
  }

  function openModal(html) {
    document.getElementById('modalContainer').innerHTML =
      `<div class="modal-overlay" onclick="handleOverlayClick(event)">${html}</div>`;
  }
  function handleOverlayClick(e) {
    if (e.target.classList.contains('modal-overlay')) closeModal();
  }
  function closeModal() { document.getElementById('modalContainer').innerHTML=''; }

  function openAddModal() {
    openModal(`<div class="modal">
      <h3>Add New Test</h3>
      <div class="form-row">
        <div class="form-group"><label>Code</label><input id="f-code" placeholder="e.g. CBC-002"/></div>
        <div class="form-group"><label>TAT</label><input id="f-tat" placeholder="e.g. 4 hrs"/></div>
      </div>
      <div class="form-group"><label>Test Name</label><input id="f-name" placeholder="Test name"/></div>
      <div class="form-group"><label>Category</label>
        <select id="f-cat">
          <option>Hematology</option><option>Chemistry</option>
          <option>Microbiology</option><option>Endocrinology</option><option>Immunology</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Unit Price (&#8369;)</label><input type="number" id="f-price" placeholder="0"/></div>
        <div class="form-group"><label>Bulk Price (&#8369;)</label><input type="number" id="f-bulk" placeholder="0"/></div>
      </div>
      <div class="modal-actions">
        <button class="btn-outline" onclick="closeModal()">Cancel</button>
        <button class="btn-primary" onclick="saveNew()">Save Test</button>
      </div>
    </div>`);
  }

  function saveNew() {
    const code=document.getElementById('f-code').value.trim();
    const name=document.getElementById('f-name').value.trim();
    const cat=document.getElementById('f-cat').value;
    const tat=document.getElementById('f-tat').value.trim();
    const price=parseInt(document.getElementById('f-price').value)||0;
    const bulk=parseInt(document.getElementById('f-bulk').value)||0;
    if(!code||!name){showToast('Code and name are required.');return;}
    const newId=tests.length?Math.max(...tests.map(t=>t.id))+1:1;
    tests.push({id:newId,code,name,sub:cat,category:cat,tat,price,bulk});
    closeModal(); renderTable(); showToast('Test added!');
  }

  function openEditModal(id) {
    const t=tests.find(x=>x.id===id);
    const cats=['Hematology','Chemistry','Microbiology','Endocrinology','Immunology'];
    openModal(`<div class="modal">
      <h3>Edit Test</h3>
      <div class="form-row">
        <div class="form-group"><label>Code</label><input id="e-code" value="${t.code}"/></div>
        <div class="form-group"><label>TAT</label><input id="e-tat" value="${t.tat}"/></div>
      </div>
      <div class="form-group"><label>Test Name</label><input id="e-name" value="${t.name}"/></div>
      <div class="form-group"><label>Category</label>
        <select id="e-cat">
          ${cats.map(c=>`<option${c===t.category?' selected':''}>${c}</option>`).join('')}
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Unit Price (&#8369;)</label><input type="number" id="e-price" value="${t.price}"/></div>
        <div class="form-group"><label>Bulk Price (&#8369;)</label><input type="number" id="e-bulk" value="${t.bulk}"/></div>
      </div>
      <div class="modal-actions">
        <button class="btn-outline" onclick="closeModal()">Cancel</button>
        <button class="btn-primary" onclick="saveEdit(${id})">Update</button>
      </div>
    </div>`);
  }

  function saveEdit(id) {
    const t=tests.find(x=>x.id===id);
    t.code=document.getElementById('e-code').value.trim();
    t.name=document.getElementById('e-name').value.trim();
    t.category=document.getElementById('e-cat').value;
    t.sub=t.category;
    t.tat=document.getElementById('e-tat').value.trim();
    t.price=parseInt(document.getElementById('e-price').value)||0;
    t.bulk=parseInt(document.getElementById('e-bulk').value)||0;
    closeModal(); renderTable(); showToast('Test updated!');
  }

  function openBulkImport() {
    openModal(`<div class="modal">
      <h3>Bulk Import Tests</h3>
      <p style="font-size:13px;color:#888;margin-bottom:16px;">Upload a CSV with columns: Code, Name, Category, TAT, Unit Price, Bulk Price</p>
      <div class="drop-zone">
        <div style="font-size:24px;margin-bottom:8px;">&#128193;</div>
        Drop CSV here or <span style="color:#3d4d8a;cursor:pointer">browse</span>
      </div>
      <div class="modal-actions" style="margin-top:14px">
        <button class="btn-outline" onclick="closeModal()">Cancel</button>
        <button class="btn-primary" onclick="closeModal();showToast('Import coming soon!')">Import</button>
      </div>
    </div>`);
  }

  renderTable();
</script>
</body>
</html>
