            const currentCollected = 61284;
            const newCollected = currentCollected + 21530;
            document.getElementById('collectedValue').textContent = '₱ ' + newCollected.toLocaleString();
            
            closeModal();
            showToast('Invoice marked as paid successfully!', 'success');
