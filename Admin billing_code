<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>CLINIQ - Billing</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: #ffffff;
      font-size: 13px;
    }

    .top-navbar {
      background-color: #75bb98;
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 14px;
      gap: 0;
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
    }
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #ffffff;
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 2px;
      width: 200px;
      flex-shrink: 0;
    }
    .navbar-brand img {
      height: 28px; width: 28px;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }
    .navbar-search { flex: 1; max-width: 2000px; }
    .search-display {
      width: 100%; height: 32px;
      border-radius: 20px;
      background: #ffffff;
    }

    .sidebar {
      position: fixed;
      top: 52px; left: 0;
      width: 200px;
      height: calc(100vh - 52px);
      background-color: #ffffff;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      z-index: 99;
      border-right: 1px solid #e4eaf2;
    }

    .user-card {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 14px 12px 12px;
      background: #75bb98;
      border-radius: 10px;
      padding: 9px 11px;
    }
    .user-avatar {
      background: #ffffff;
      color: #5d77a6;
      font-weight: 700;
      font-size: 0.78rem;
      width: 36px; height: 36px;
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .user-name { color: #ffffff; font-weight: 600; font-size: 0.78rem; line-height: 1.3; }
    .user-role { color: rgba(255,255,255,0.75); font-size: 0.67rem; }

    .nav-section-pill {
      display: inline-block;
      background: #75bb98;
      color: #ffffff;
      font-size: 0.72rem;
      font-weight: 700;
      border-radius: 20px;
      padding: 3px 14px;
      margin: 8px 12px 4px;
    }

    .nav-link-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px;
      color: #75bb98;
      font-size: 0.78rem;
      font-weight: 500;
      text-decoration: none;
      transition: background 0.12s;
    }
    .nav-link-item:hover { background: #f0f4fa; color: #75bb98; }
    .nav-link-item.active { background: #eef2fb; font-weight: 700; }
    .nav-link-item i { font-size: 1.05rem; width: 20px; color: #6082b6; }

    .sign-out-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 10px 12px 6px;
      background: #75bb98;
      border-radius: 20px;
      padding: 7px 14px;
      color: #ffffff;
      font-size: 0.78rem;
      font-weight: 600;
      text-decoration: none;
      width: fit-content;
      cursor: pointer;
      border: none;
    }
    .sign-out-btn:hover { background: #4a6290; color: #ffffff; }

    .sidebar-logo-bottom {
      margin-top: auto;
      display: flex;
      justify-content: center;
      padding: 16px 0 18px;
    }
    .sidebar-logo-bottom img { height: 60px; width: 60px; object-fit: contain; }

    .main-wrapper {
      margin-left: 200px;
      margin-top: 52px;
      padding: 26px 28px;
    }

    .page-title { font-size: 1.45rem; font-weight: 700; color: #2f6a4d; }
    .page-subtitle { color: #2f6a4d; font-size: 0.78rem; margin-top: 3px; }

    .tab-bar {
      display: flex;
      gap: 6px;
      margin: 18px 0 16px;
    }
    .tab-btn {
      padding: 6px 18px;
      border-radius: 20px;
      border: 1.5px solid #c9d3e0;
      background: #ffffff;
      font-family: 'Poppins', sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      color: #5d77a6;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .tab-btn.active {
      background: #5d77a6;
      color: #ffffff;
      border-color: #5d77a6;
      font-weight: 600;
    }
    .tab-btn:hover:not(.active) { background: #f0f4fa; }

    .alert-banner {
      background: #fffae6;
      border: 1.5px solid #fef9c3;
      border-radius: 10px;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.82rem;
      font-weight: 500;
      color: #ca8a04;
      margin-bottom: 22px;
    }
    .alert-banner i { color: #f5c842; font-size: 1.1rem; }

    .patient-card {
      background: #ffcf60;
      border: 1.5px solid #f0e8c8;
      border-radius: 12px;
      padding: 18px 20px;
      margin-bottom: 18px;
    }
    .patient-card.normal-card {
      background: #f8fff8;
      border-color: #c8e6c9;
    }

    .patient-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .patient-info-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: #222;
    }
    .patient-info-meta {
      font-size: 0.72rem;
      color: #666;
      margin-top: 2px;
    }
    .patient-info-meta a {
      color: #5d77a6;
      text-decoration: none;
      font-weight: 600;
    }
    .patient-info-meta a:hover { text-decoration: underline; }

    .patient-card-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .badge-abnormal {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #fff0f0;
      border: 1.5px solid #e57373;
      color: #c62828;
      font-size: 0.72rem;
      font-weight: 700;
      border-radius: 20px;
      padding: 5px 14px;
    }
    .badge-abnormal i { font-size: 0.85rem; color: #e57373; }

    .badge-normal {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #e8f5e9;
      border: 1.5px solid #66bb6a;
      color: #2e7d32;
      font-size: 0.72rem;
      font-weight: 700;
      border-radius: 20px;
      padding: 5px 14px;
    }

    .btn-pdf {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #2e7d32;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      padding: 7px 16px;
      font-family: 'Poppins', sans-serif;
      font-size: 0.76rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-pdf:hover { background: #1b5e20; }
    .btn-pdf i { font-size: 0.9rem; }

    .results-table {
      width: 100%;
      border-collapse: collapse;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e0e0e0;
    }
    .results-table thead th {
      background: #f5f5f5;
      color: #000;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 16px;
      text-align: left;
      border-bottom: 1.5px solid #e0e0e0;
    }
    .results-table tbody td {
      padding: 11px 16px;
      font-size: 0.78rem;
      border-bottom: 1px solid #f0f0f0;
      vertical-align: middle;
    }
    .results-table tbody tr:last-child td { border-bottom: none; }

    .result-high { color: #c62828; font-weight: 700; }
    .result-normal-val { color: #2e7d32; font-weight: 600; }
    .result-low { color: #1565c0; font-weight: 700; }

    .flag-high {
      color: #c62828;
      font-weight: 700;
      font-size: 0.72rem;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .flag-high::before { content: "↑ "; }

    .flag-normal {
      color: #2e7d32;
      font-weight: 600;
      font-size: 0.72rem;
    }

    .flag-low {
      color: #1565c0;
      font-weight: 700;
      font-size: 0.72rem;
    }
    .flag-low::before { content: "↓ "; }

    .tab-content-panel { display: none; }
    .tab-content-panel.active { display: block; }

    .invoice-table {
      width: 100%;
      border-collapse: collapse;
      border-radius: 10px;
      overflow: hidden;
      border: 1.5px solid #c9c9c6;
    }
    .invoice-table thead th {
      background: #f8f9fb;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      padding: 12px 16px;
      border-bottom: 1.5px solid #c9c9c6;
      color: #000;
    }
    .invoice-table tbody td {
      padding: 12px 16px;
      font-size: 0.78rem;
      color: #444;
      border-bottom: 1px solid #f0f0f0;
    }
    .invoice-table tbody tr:last-child td { border-bottom: none; }
    .invoice-table tfoot td {
      padding: 12px 16px;
      font-size: 0.82rem;
      font-weight: 700;
      border-top: 1.5px solid #c9c9c6;
      background: #f8f9fb;
    }

    .status-paid { background: #e8f5e9; color: #2e7d32; border-radius: 20px; padding: 3px 12px; font-size: 0.7rem; font-weight: 700; display: inline-block; }
    .status-unpaid { background: #fff3e0; color: #e65100; border-radius: 20px; padding: 3px 12px; font-size: 0.7rem; font-weight: 700; display: inline-block; }

    .history-card {
      background: #fff;
      border: 1.5px solid #c9c9c6;
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .history-date { font-size: 0.72rem; color: #888; }
    .history-amount { font-size: 1rem; font-weight: 700; color: #5d77a6; }
    .history-ref { font-size: 0.72rem; color: #aaa; }

    .toast-msg {
      position: fixed;
      bottom: 28px; right: 28px;
      background: #5873a1;
      color: #ffffff;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: 'Poppins', sans-serif;
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.25s, transform 0.25s;
      pointer-events: none;
      z-index: 9999;
    }
    .toast-msg.show { opacity: 1; transform: translateY(0); }

    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.show { display: flex; }
    .modal-box {
      background: #fff;
      border-radius: 14px;
      padding: 28px 32px;
      max-width: 480px;
      width: 90%;
      box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    }
    .modal-title { font-size: 1rem; font-weight: 700; color: #000; margin-bottom: 8px; }
    .modal-body { font-size: 0.82rem; color: #555; margin-bottom: 20px; }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
    .modal-btn-cancel {
      background: #f0f0f0; border: none; border-radius: 8px;
      padding: 8px 20px; font-family: 'Poppins', sans-serif;
      font-size: 0.78rem; font-weight: 500; cursor: pointer;
    }
    .modal-btn-download {
      background: #2e7d32; color: #fff; border: none; border-radius: 8px;
      padding: 8px 20px; font-family: 'Poppins', sans-serif;
      font-size: 0.78rem; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; gap: 6px;
    }
    .modal-btn-download:hover { background: #1b5e20; }
  </style>
</head>
<body>

<!-- TOP NAVBAR -->
<div class="top-navbar">
  <div class="navbar-brand">
    <img src="logo.png" alt="logo"/>
    CLINIQ
  </div>
  <div class="navbar-search">
    <div class="search-display"></div>
  </div>
</div>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="user-card">
    <div class="user-avatar">SL</div>
    <div>
      <div class="user-name">St. Luke's Clinic</div>
      <div class="user-role">Clinic User</div>
    </div>
  </div>
  <span class="nav-section-pill">Overview</span>
  <a href="#" class="nav-link-item"><i class="bi bi-grid-1x2"></i> Dashboard</a>
  <a href="#" class="nav-link-item"><i class="bi bi-flask"></i> Lab Requests</a>
  <a href="#" class="nav-link-item active"><i class="bi bi-receipt"></i> Billing</a>
  <a href="#" class="nav-link-item"><i class="bi bi-bar-chart-line"></i> Analytics</a>
  <button class="sign-out-btn"><i class="bi bi-box-arrow-right"></i> Sign Out</button>
  <div class="sidebar-logo-bottom">
    <img src="logo.png" alt="logo"/>
  </div>
</div>

<div class="main-wrapper">
  <div class="page-title">Billing</div>
  <div class="page-subtitle">Monthly statements from MetroMed Diagnostics</div>

  <div class="tab-bar">
    <button class="tab-btn" onclick="switchTab('invoice', this)">Current Invoice</button>
    <button class="tab-btn" onclick="switchTab('history', this)">Payment History</button>
    <button class="tab-btn active" onclick="switchTab('results', this)">Lab Results</button>
  </div>

  <div id="tab-results" class="tab-content-panel active">

    <div class="alert-banner">
      <i class="bi bi-exclamation-triangle-fill"></i>
      3 Results have abnormal values – review before releasing to patient
    </div>

    <div class="patient-card" id="card-antoinette">
      <div class="patient-card-header">
        <div>
          <div class="patient-info-name">Antoinette Curitana <span style="font-size:0.78rem;font-weight:400;color:#888;">F, 19y · PT-12654562</span></div>
          <div class="patient-info-meta">Dr. Katarina Yu · Apr 7, 2026 <a href="#">#REQ-2026-001</a></div>
        </div>
        <div class="patient-card-actions">
          <span class="badge-abnormal"><i class="bi bi-exclamation-circle"></i> Abnormal</span>
          <button class="btn-pdf" onclick="openPdfModal('Antoinette Curitana', 'REQ-2026-001')"><i class="bi bi-download"></i> PDF</button>
        </div>
      </div>
      <table class="results-table">
        <thead>
          <tr>
            <th>Test</th>
            <th>Result</th>
            <th>Reference Range</th>
            <th>Flag</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background:#fff8f8;">
            <td>HbA1c</td>
            <td class="result-high">7.8%</td>
            <td>4.0–5.6%</td>
            <td><span class="flag-high">HIGH</span></td>
          </tr>
          <tr style="background:#fff8f8;">
            <td>Fasting Glucose</td>
            <td class="result-high">148mg/DL</td>
            <td>70/100 mg/DL</td>
            <td><span class="flag-high">HIGH</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="patient-card normal-card" id="card-pedro">
      <div class="patient-card-header">
        <div>
          <div class="patient-info-name">Pedro Bautista <span style="font-size:0.78rem;font-weight:400;color:#888;">M, 64y · PT-12654562</span></div>
          <div class="patient-info-meta">Dr. Katarina Yu · Apr 7, 2026 <a href="#">#REQ-2026-002</a></div>
        </div>
        <div class="patient-card-actions">
          <span class="badge-normal"><i class="bi bi-check-circle"></i> Normal</span>
          <button class="btn-pdf" onclick="openPdfModal('Pedro Bautista', 'REQ-2026-002')"><i class="bi bi-download"></i> PDF</button>
        </div>
      </div>
      <table class="results-table">
        <thead>
          <tr>
            <th>Test</th>
            <th>Result</th>
            <th>Reference Range</th>
            <th>Flag</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>CBC-WBC</td>
            <td class="result-normal-val">7.2 x 10/L</td>
            <td>4.5–11.0</td>
            <td><span class="flag-normal">Normal</span></td>
          </tr>
          <tr>
            <td>CBC-Hemoglobin</td>
            <td class="result-normal-val">146mg/DL</td>
            <td>13.5 – 17.5</td>
            <td><span class="flag-normal">Normal</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="patient-card" id="card-rosa">
      <div class="patient-card-header">
        <div>
          <div class="patient-info-name">Rosa Dela Cruz <span style="font-size:0.78rem;font-weight:400;color:#888;">F, 45y · PT-12654563</span></div>
          <div class="patient-info-meta">Dr. Katarina Yu · Apr 7, 2026 <a href="#">#REQ-2026-003</a></div>
        </div>
        <div class="patient-card-actions">
          <span class="badge-abnormal"><i class="bi bi-exclamation-circle"></i> Abnormal</span>
          <button class="btn-pdf" onclick="openPdfModal('Rosa Dela Cruz', 'REQ-2026-003')"><i class="bi bi-download"></i> PDF</button>
        </div>
      </div>
      <table class="results-table">
        <thead>
          <tr>
            <th>Test</th>
            <th>Result</th>
            <th>Reference Range</th>
            <th>Flag</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background:#fff8f8;">
            <td>Cholesterol Total</td>
            <td class="result-high">245mg/DL</td>
            <td>&lt;200 mg/DL</td>
            <td><span class="flag-high">HIGH</span></td>
          </tr>
          <tr>
            <td>HDL Cholesterol</td>
            <td class="result-normal-val">52mg/DL</td>
            <td>≥40 mg/DL</td>
            <td><span class="flag-normal">Normal</span></td>
          </tr>
          <tr style="background:#fff8f8;">
            <td>LDL Cholesterol</td>
            <td class="result-high">168mg/DL</td>
            <td>&lt;130 mg/DL</td>
            <td><span class="flag-high">HIGH</span></td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>

  <div id="tab-invoice" class="tab-content-panel">
    <table class="invoice-table">
      <thead>
        <tr>
          <th>Invoice #</th>
          <th>Date</th>
          <th>Patient</th>
          <th>Tests</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>#INV-2026-041</strong></td>
          <td>Apr 7, 2026</td>
          <td>Antoinette Curitana</td>
          <td>HbA1c, Fasting Glucose</td>
          <td><strong>₱ 1,200.00</strong></td>
          <td><span class="status-unpaid">Unpaid</span></td>
          <td><button class="btn-pdf" style="padding:5px 12px;font-size:0.72rem;" onclick="showToast('Invoice #INV-2026-041 marked as paid')">Pay Now</button></td>
        </tr>
        <tr>
          <td><strong>#INV-2026-042</strong></td>
          <td>Apr 7, 2026</td>
          <td>Pedro Bautista</td>
          <td>CBC-WBC, CBC-Hemoglobin</td>
          <td><strong>₱ 950.00</strong></td>
          <td><span class="status-paid">Paid</span></td>
          <td><button class="btn-pdf" style="padding:5px 12px;font-size:0.72rem;" onclick="openPdfModal('Pedro Bautista', 'INV-2026-042')"><i class="bi bi-download"></i> PDF</button></td>
        </tr>
        <tr>
          <td><strong>#INV-2026-043</strong></td>
          <td>Apr 7, 2026</td>
          <td>Rosa Dela Cruz</td>
          <td>Cholesterol Panel</td>
          <td><strong>₱ 1,500.00</strong></td>
          <td><span class="status-unpaid">Unpaid</span></td>
          <td><button class="btn-pdf" style="padding:5px 12px;font-size:0.72rem;" onclick="showToast('Invoice #INV-2026-043 marked as paid')">Pay Now</button></td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align:right;">Total Outstanding</td>
          <td>₱ 2,700.00</td>
          <td colspan="2"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div id="tab-history" class="tab-content-panel">
    <div class="history-card">
      <div>
        <div style="font-weight:600;font-size:0.82rem;">INV-2026-038 · Pedro Bautista</div>
        <div class="history-date">Mar 15, 2026</div>
        <div class="history-ref">Ref: GCash #TXN-884921</div>
      </div>
      <div style="text-align:right;">
        <div class="history-amount">₱ 950.00</div>
        <span class="status-paid">Paid</span>
      </div>
    </div>
    <div class="history-card">
      <div>
        <div style="font-weight:600;font-size:0.82rem;">INV-2026-029 · Antoinette Curitana</div>
        <div class="history-date">Mar 2, 2026</div>
        <div class="history-ref">Ref: BDO #TXN-779021</div>
      </div>
      <div style="text-align:right;">
        <div class="history-amount">₱ 1,200.00</div>
        <span class="status-paid">Paid</span>
      </div>
    </div>
    <div class="history-card">
      <div>
        <div style="font-weight:600;font-size:0.82rem;">INV-2026-018 · Rosa Dela Cruz</div>
        <div class="history-date">Feb 11, 2026</div>
        <div class="history-ref">Ref: Cash Payment</div>
      </div>
      <div style="text-align:right;">
        <div class="history-amount">₱ 1,500.00</div>
        <span class="status-paid">Paid</span>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="pdfModal">
  <div class="modal-box">
    <div class="modal-title" id="modalTitle">Download Lab Result PDF</div>
    <div class="modal-body" id="modalBody">Download the lab result report as a PDF file?</div>
    <div class="modal-actions">
      <button class="modal-btn-cancel" onclick="closePdfModal()">Cancel</button>
      <button class="modal-btn-download" onclick="confirmPdfDownload()"><i class="bi bi-download"></i> Download PDF</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast-msg" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._timer);
    t._timer = setTimeout(() => t.classList.remove('show'), 2800);
  }

  function switchTab(tab, btn) {
    document.querySelectorAll('.tab-content-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    btn.classList.add('active');
  }

  let currentPdfPatient = '';
  let currentPdfReq = '';

  function openPdfModal(patient, req) {
    currentPdfPatient = patient;
    currentPdfReq = req;
    document.getElementById('modalTitle').textContent = 'Download Lab Result PDF';
    document.getElementById('modalBody').textContent =
  `Download the lab result report for ${patient} (${req}) as a PDF file?`;
    document.getElementById('pdfModal').classList.add('show');
  }

  function closePdfModal() {
    document.getElementById('pdfModal').classList.remove('show');
  }

  function confirmPdfDownload() {
    closePdfModal();
    showToast(`PDF downloaded for ${currentPdfPatient}`);

    const printWin = window.open('', '_blank', 'width=700,height=900');
    const now = new Date().toLocaleDateString('en-PH', { year:'numeric', month:'long', day:'numeric' });
    printWin.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Lab Result - ${currentPdfPatient}</title>
        <style>
          body { font-family: Arial, sans-serif; padding: 40px; font-size: 13px; }
          h1 { font-size: 20px; margin-bottom: 4px; }
          .sub { color: #666; font-size: 11px; margin-bottom: 24px; }
          table { width: 100%; border-collapse: collapse; margin-top: 16px; }
          th { background: #f0f0f0; padding: 8px 12px; text-align: left; font-size: 11px; text-transform: uppercase; border: 1px solid #ddd; }
          td { padding: 8px 12px; border: 1px solid #ddd; }
          .footer { margin-top: 40px; font-size: 11px; color: #999; }
        </style>
      </head>
      <body>
        <h1>CLINIQ Laboratory Results</h1>
        <div class="sub">MetroMed Diagnostics · ${now}</div>
        <p><strong>Patient:</strong> ${currentPdfPatient}</p>
        <p><strong>Request ID:</strong> ${currentPdfReq}</p>
        <table>
          <tr><th>Test</th><th>Result</th><th>Reference Range</th><th>Flag</th></tr>
          <tr><td colspan="4" style="color:#999;text-align:center;">See original report for full results.</td></tr>
        </table>
        <div class="footer">This is a system-generated document from CLINIQ. Please verify with attending physician.</div>
        <script>window.onload=()=>{window.print();}<\/script>
      </body>
      </html>
    `);
    printWin.document.close();
  }

  document.getElementById('pdfModal').addEventListener('click', function(e) {
    if (e.target === this) closePdfModal();
  });

  document.querySelector('.sign-out-btn').addEventListener('click', () => {
    if (confirm('Are you sure you want to sign out?')) {
      showToast('Signed out successfully.');
    }
  });

  document.querySelectorAll('.nav-link-item').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      document.querySelectorAll('.nav-link-item').forEach(l => l.classList.remove('active'));
      this.classList.add('active');
      showToast('Navigating to ' + this.textContent.trim());
    });
  });

</script>
</body>
</html>
